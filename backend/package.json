{
  "name": "eventsmw-backend",
  "version": "1.0.0",
  "description": "backend logic powering EventsMW; includes schemas, server logic, jobs, etc",
  "keywords": [
    "schemas",
    "jobs",
    "server-logic",
    "typescript",
    "mongoDB",
    "event-management"
  ],
  "license": "MIT",
  "author": "Divine Gombwa",
  "type": "module",
  "main": "/src/server.ts",
  "scripts": {
    "dev": "nodemon --watch src --exec \"node --loader ts-node/esm src/server.ts\"",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jose": "^6.1.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.0.0",
    "validator": "^13.15.26",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.96",
    "@types/node": "^24.10.1",
    "@types/validator": "^13.15.10",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
